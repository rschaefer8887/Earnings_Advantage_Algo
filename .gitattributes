# Normalize text files to LF in the repo and working tree (quieter diffs on Windows).
* text=auto eol=lf

*.py text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.editorconfig text eol=lf

# Task Scheduler exports are UTF-16; do not normalize as LF text.
"Admin/Windows Tasks/*.xml" binary

# Keep Office / binary assets untouched.
*.xlsx binary
*.xls binary
*.xlsm binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.exe binary
*.dll binary
*.pkl binary
*.parquet binary